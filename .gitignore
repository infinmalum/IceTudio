# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Wails / frontend outputs and workspace-local caches
.task/
.cache/
.mimosa/
bin/
frontend/dist/
frontend/node_modules/
frontend/bindings/
frontend/tsconfig.tsbuildinfo
frontend/e2e/__pycache__/

# Mobile scaffolding is outside ICEPick's desktop target.
build/android/
build/ios/

# Files regenerated by the desktop build tasks.
build/linux/icepick.desktop
build/linux/icetudio.desktop
build/linux/desktop
build/darwin/Assets.car
build/darwin/icons.icns
build/windows/icon.ico
build/wails_windows_*.syso
build/linux/appimage/build/
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe

# Portable application state beside a workspace-root executable
/data/

# 默认音色大文件不进 Git 历史（授权档案与 NOTICE 保留；用 scripts/fetch-soundfont.sh 拉取）
assets/soundfonts/*.sf2
assets/soundfonts/*.sf3

# Local implementation plans, stage contracts and validation records.
# Keep these files on disk without publishing them with the code.
/IMPLEMENTATION_PLAN.md
/docs/p[0-9]-*.md
/docs/validation/
/docs/history/*implementation*.md
