# GUI-independent IceTudio CLI/IPC host. The base images are supplied by the
# maintainer with Go >= 1.27.3, C compiler, SQLite/FluidSynth build prerequisites
# and runtime FluidSynth >= 2.6. This file never invents an HTTP server.
ARG GO_IMAGE=icetudio-build-deps:1.27.3
ARG RUNTIME_IMAGE=icetudio-runtime-deps:2.6
FROM ${GO_IMAGE} AS builder
WORKDIR /src
COPY . .
RUN CGO_ENABLED=1 go build -trimpath -o /icetudio ./cmd/icetudio-cli
FROM ${RUNTIME_IMAGE}
COPY --from=builder /icetudio /usr/local/bin/icetudio
ENV ICETUDIO_DATA_DIR=/var/lib/icetudio
VOLUME ["/var/lib/icetudio"]
ENTRYPOINT ["/usr/local/bin/icetudio"]
CMD ["serve"]
