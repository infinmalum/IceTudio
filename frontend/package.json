{
  "name": "icetudio-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/dev.mjs",
    "build:dev": "tsc -p tsconfig.mygo.json && vite build --config mygo.vite.config.ts --minify false",
    "build": "tsc -p tsconfig.mygo.json && vite build --config mygo.vite.config.ts",
    "preview": "vite preview",
    "test:ui": "node e2e/product.mjs",
    "test:music": "node --experimental-strip-types --test tests/time-map.test.ts tests/gm.test.ts tests/piano-projection.test.ts tests/piano-viewport.test.ts",
    "build:mygo": "tsc -p tsconfig.mygo.json && vite build --config mygo.vite.config.ts",
    "test:native": "node e2e/native.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.2.2",
    "vite": "^8.0.5"
  },
  "license": "AGPL-3.0-only"
}
